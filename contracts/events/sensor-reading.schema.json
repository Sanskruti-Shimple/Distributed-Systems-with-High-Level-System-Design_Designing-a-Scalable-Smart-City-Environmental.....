{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metrovale Sensor Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["deviceId", "eventId", "observedAt", "readings"],
  "properties": {
    "deviceId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "eventId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "observedAt": { "type": "string", "format": "date-time" },
    "location": { "type": "string", "minLength": 1, "maxLength": 128 },
    "readings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "unit"],
        "properties": {
          "metric": {
            "enum": ["AQI", "PM2.5", "Temperature", "Humidity", "Noise"]
          },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 16 }
        }
      }
    }
  }
}
